generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  duprRating     Float     @default(0.0)
  credits        Decimal   @default(0.00) @db.Decimal(10, 2)
  membership     String    @default("STANDARD") // STANDARD, VIP, PRO
  role           String    @default("PLAYER")   // PLAYER, ADMIN
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  yardPoints     Int       @default(0)
  lifetimeYardPoints Int   @default(0)

  accounts     Account[]
  sessions     Session[]
  bookings     Booking[]
  paddleStacks PaddleStack[]
  transactions Transaction[]
  yardPointLogs YardPointLog[]
  redemptions   RedemptionRequest[]
  vouchers      Voucher[]           @relation("UserVouchers")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Court {
  id        String    @id @default(cuid())
  number    Int       @unique
  name      String
  type      String    // INDOOR, OUTDOOR, ROOFTOP
  status             String    // AVAILABLE, OCCUPIED, MAINTENANCE
  gameStartedAt      DateTime?
  gameDurationSecond Int?      @default(900)
  createdAt          DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings  Booking[]

  @@map("courts")
}

enum BookingStatus {
  PENDING
  RESERVED
  PAID
  CANCELLED
  EXPIRED
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  courtId   String
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(PENDING)
  price     Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  court     Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@map("bookings")
}

enum SkillLevel {
  NOVICE
  INTERMEDIATE
  ADVANCED
}

model PaddleStack {
  id         String     @id @default(cuid())
  userId     String
  skillLevel SkillLevel
  courtId    String?
  joinedAt   DateTime   @default(now())
  checkedInAt DateTime?
  sessionExpiresAt DateTime?
  status     String     // WAITING, PLAYING, COMPLETED
  qrId       String?    @unique

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("paddlestacks")
}

model ClubEvent {
  id              String   @id @default(cuid())
  title           String
  description     String   @db.Text
  scheduledAt     DateTime
  location        String
  price           Decimal  @db.Decimal(10, 2)
  capacity        Int
  registeredCount Int      @default(0)
  type            String   @default("CLINIC")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("club_events")
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Decimal  @db.Decimal(10, 2)
  type        String   // TOPUP, BOOKING_DEBIT, EVENT_DEBIT, REFUND
  reference   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("system_settings")
}

model YardPointLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Int      // Positive for earning, negative for spending
  reason    String   // OPEN_PLAY_PARTICIPATION, OPEN_PLAY_WIN, TOPUP, REDEMPTION, DAILY_LOGIN, SPECIAL_EVENT
  details   String?  @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("yard_point_logs")
}

model ShopProduct {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  category    String   // DRINK, VOUCHER, COURT_TIME, MERCHANDISE, OTHER
  pointsCost  Int
  stock       Int      @default(-1) // -1 for unlimited
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions RedemptionRequest[]

  @@map("shop_products")
}

model RedemptionRequest {
  id              String   @id @default(cuid())
  userId          String
  productId       String
  pointsDeducted  Int
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  notes           String?  @db.Text // Extra info (e.g. Voucher Code or rejection reason)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("redemption_requests")
}

model Voucher {
  id        String    @id @default(cuid())
  code      String    @unique
  amount    Decimal   @db.Decimal(10, 2)
  isUsed    Boolean   @default(false)
  usedById  String?
  usedAt    DateTime?
  expiresAt DateTime?
  batchId   String?
  createdAt DateTime  @default(now())

  user      User?     @relation("UserVouchers", fields: [usedById], references: [id], onDelete: SetNull)

  @@map("vouchers")
}
